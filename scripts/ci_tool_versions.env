# Expected CI tool versions. CI fails loudly on mismatch, so version drift is
# a conscious bump here, never a silent fallback.
# Both tools install from their pinned release binaries (runner images drift
# between brew versions mid-fleet); the checksums pin the exact artifacts.
# To bump a version: change the *_VERSION, then update the matching *_SHA256 to
# `shasum -a 256` of the new release zip.
SWIFTLINT_VERSION=0.63.3
SWIFTLINT_ZIP_SHA256=fb045e85e7cb3374f42a4840b6b85a0106302afa69035c0c6f29af4a44c810b6
XCODEGEN_VERSION=2.45.4
XCODEGEN_ZIP_SHA256=090ec29491aad50aec10631bf6e62253fed733c50f3aab0f5ffc86bc170bdbef
